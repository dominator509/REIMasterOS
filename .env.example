# REI-OS Environment Configuration
# Copy this file to .env.local for local development
# Compose reads `.env` by default; keep it untracked and never copy real values here.

NODE_ENV=development
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001

# Build only: set to 1 on Windows only when symlink creation is enabled.
# REI_OS_NEXT_STANDALONE=1

# Database (required after EP-003)
# DATABASE_URL=postgresql://rei:rei@localhost:5432/rei_os

# Redis (required after EP-003)
# REDIS_URL=redis://localhost:6379/0

# Search
SEARCH_PROVIDER=disabled
# SEARCH_URL=http://localhost:9200

# Object Storage
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=rei-os-local
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
# OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin

# Auth
AUTH_PROVIDER=built-in
# SESSION_SECRET=replace-with-at-least-32-byte-secret-key
# ENCRYPTION_KEY=base64:replace-with-32-byte-base64-key
SESSION_COOKIE_NAME=rei_os_session
CSRF_COOKIE_NAME=rei_os_csrf
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=1800
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_SENSITIVE_REQUESTS=60
RATE_LIMIT_WEBHOOK_REQUESTS=300
MFA_ENABLED=false
PASSWORD_MIN_LENGTH=12
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Email (optional)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Deployment-only image and secret references (examples; supply outside Git)
# DB_PASSWORD=
# REDIS_PASSWORD=
# MINIO_USER=
# MINIO_PASSWORD=
# OPENSEARCH_PASSWORD=
# GRAFANA_PASSWORD=
# API_IMAGE=registry.example.test/rei-os-api@sha256:<digest>
# WEB_IMAGE=registry.example.test/rei-os-web@sha256:<digest>
# LOCAL_LLM_IMAGE=ollama/ollama:<owner-approved-pinned-tag-or-digest>
