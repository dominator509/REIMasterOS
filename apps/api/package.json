{
  "name": "@rei-os/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "nest start --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "build": "nest build",
    "db:migrate": "pnpm --filter @rei-os/persistence db:migrate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@rei-os/contracts": "workspace:*",
    "@rei-os/config": "workspace:*",
    "@rei-os/domain": "workspace:*",
    "@rei-os/observability": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0",
    "@rei-os/persistence": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.18",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "eslint": "^9.0.0"
  }
}
